# Copy this file to .env and fill in your own local values.
# Never commit the real .env file.

DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_local_postgres_password
DATABASE_NAME=social_media_api

# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_own_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
